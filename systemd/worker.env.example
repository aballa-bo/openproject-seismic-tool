# /etc/openproject-seismic/worker.env  (created by install.sh, mode 600)
SEISMIC_DATABASE_URL=postgres://user:password@127.0.0.1/openproject
SEISMIC_MODELS_DIR=/var/db/openproject/seismic_tool/models
SEISMIC_DETECTOR_WEIGHTS=masonry_det.pt
SEISMIC_CRACK_WEIGHTS=crack_seg.pt
# PyTorch / OpenCV threads. 1-2 keeps the machine usable; the process also runs under SCHED_IDLE.
SEISMIC_THREADS=2
# seconds between two images, and idle polling interval
SEISMIC_PAUSE_SECONDS=1
SEISMIC_POLL_SECONDS=5
# do not start a new image while the 1-minute load average per core is above this.
# The process already runs under SCHED_IDLE / nice 19 / CPUWeight=1 and cannot slow the
# web server, so this is only a safety net for extreme load (e.g. a flood of OCR jobs).
SEISMIC_MAX_LOAD_PER_CORE=4.0
