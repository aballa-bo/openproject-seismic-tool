<% html_title 'Damage suggestions' %>
<%= render 'seismic_jobs/nav' %>
<h2>Suggested damage – to be verified</h2>
<p class="seismic-note">
  The image analysis only <b>suggests</b> where damage may be. Confirm a suggestion to record it: choose the
  collapse mechanism (cracks) or the element, the damage level and the measures, and an AeDES work package is created
  from it. The survey form is then compiled from those work packages.
</p>

<% unless @types_ready %>
  <div class="seismic-warn">
    The work package types <i>AeDES – Danno strutturale / non strutturale</i> (or their custom fields) are missing:
    run the plugin migrations or create them under Administration → Types / Custom fields.
  </div>
<% end %>

<%= form_tag project_seismic_suggestions_path(@project), method: :get, class: 'seismic-inline' do %>
  <%= select_tag :status, options_for_select(SeismicSuggestion::STATUSES.map { |s| ["#{s} (#{@counts[s].to_i})", s] }, @status) %>
  <%= select_tag :kind, options_for_select([['All kinds', ''], ['Structural (cracks)', 'structural'], ['Non structural (degradation)', 'non_structural']], @kind) %>
  <label>Min confidence <%= number_field_tag :min, @min, step: 0.05, min: 0, max: 1, style: 'width:80px' %></label>
  <%= submit_tag 'Filter', class: 'button' %>
<% end %>

<% if @suggestions.empty? %>
  <p>No suggestions here.</p>
<% end %>

<div class="seismic-grid seismic-sugg">
  <% @suggestions.each do |s| %>
    <% r = s.seismic_image_result; job = r.seismic_job; box = s.box %>
    <% kind = r.overlay_path.present? ? 'overlay' : 'source' %>
    <% src = result_image_project_seismic_job_path(@project, job, result_id: r.id, kind: kind) %>
    <figure class="seismic-card">
      <% if box && r.width && r.height %>
        <% pad = 0.25; bw = box[2] - box[0]; bh = box[3] - box[1]
           x0 = [box[0] - bw * pad, 0].max; y0 = [box[1] - bh * pad, 0].max
           x1 = [box[2] + bw * pad, r.width].min; y1 = [box[3] + bh * pad, r.height].min
           cw = [x1 - x0, 1].max; ch = [y1 - y0, 1].max
           bgw = (r.width / cw * 100).round(1)
           posx = r.width > cw ? (x0 / (r.width - cw) * 100).round(1) : 0
           posy = r.height > ch ? (y0 / (r.height - ch) * 100).round(1) : 0 %>
        <a href="<%= src %>" target="_blank" class="seismic-crop"
           style="aspect-ratio: <%= (cw / ch).round(3) %>; background-image:url('<%= src %>'); background-size: <%= bgw %>% auto; background-position: <%= posx %>% <%= posy %>%"></a>
      <% else %>
        <a href="<%= src %>" target="_blank"><img loading="lazy" src="<%= src %>" alt=""></a>
      <% end %>
      <figcaption>
        <b><%= SeismicTool::DamageSummary.label(s.damage_class).capitalize %></b>
        <span class="seismic-badge"><%= (s.confidence.to_f * 100).round %>%</span>
        <span class="seismic-badge <%= s.structural? ? 'seismic-running' : 'seismic-queued' %>"><%= s.structural? ? 'structural' : 'non structural' %></span><br>
        <small><%= r.filename %></small>
        <% d = s.detail.to_h %>
        <% if d['length_px'] %><br><small>length <%= d['length_px'] %> px · mean width <%= d['mean_width_px'] %> px</small><% end %>

        <% if s.status == 'confirmed' && s.work_package %>
          <br>→ <%= link_to "Work package ##{s.work_package.id}", work_package_path(s.work_package) %>
        <% elsif s.status == 'rejected' %>
          <br><small>rejected</small>
          <% if @can_verify %><%= button_to 'Reopen', reopen_project_seismic_suggestion_path(@project, s), class: 'button' %><% end %>
        <% elsif @can_verify %>
          <details class="seismic-verify">
            <summary>Verify…</summary>
            <%= form_tag confirm_project_seismic_suggestion_path(@project, s), method: :post do %>
              <%= hidden_field_tag :filter_kind, @kind %><%= hidden_field_tag :filter_min, @min %>
              <% if s.structural? %>
                <label>Collapse mechanism
                  <%= select_tag :mechanism, options_for_select([['—', '']] + SeismicTool::AedesWorkPackages::MECHANISMS) %></label>
              <% else %>
                <label>Element <%= text_field_tag :element, nil, placeholder: 'e.g. fresco, parete nord' %></label>
              <% end %>
              <label>Damage level
                <%= select_tag :level, options_for_select([['—', '']] + SeismicTool::AedesWorkPackages::LEVELS.each_with_index.map { |l, i| [l, i] }) %></label>
              <label>Kind
                <%= select_tag :damage_type, options_for_select(SeismicTool::AedesWorkPackages::DAMAGE_TYPES) %></label>
              <fieldset class="seismic-pi"><legend>Emergency measures (A20)</legend>
                <% SeismicTool::AedesWorkPackages::PI.each do |p| %>
                  <label class="seismic-check"><%= check_box_tag 'pi[]', p, false, id: nil %> <%= p %></label>
                <% end %>
                <label>Extent <%= select_tag :extent, options_for_select([['—', '']] + SeismicTool::AedesWorkPackages::EXTENT) %></label>
              </fieldset>
              <label>Notes <%= text_area_tag :note, nil, rows: 2 %></label>
              <%= submit_tag 'Confirm → create work package', class: 'button -primary' %>
            <% end %>
            <%= button_to 'Reject', reject_project_seismic_suggestion_path(@project, s), class: 'button',
                          params: { filter_kind: @kind, filter_min: @min } %>
          </details>
        <% end %>
      </figcaption>
    </figure>
  <% end %>
</div>
