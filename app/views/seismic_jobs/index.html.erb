<% html_title 'Seismic tool' %>
<%= render 'seismic_jobs/nav' %>
<h2>Masonry defect detection</h2>

<% hint = SeismicJob.worker_hint %>
<% if hint %><div class="seismic-warn"><%= hint %></div><% end %>

<% if User.current.allowed_in_project?(:run_seismic_analysis, @project) %>
  <p><%= link_to 'New analysis from documents', new_project_seismic_job_path(@project), class: 'button -primary' %></p>
<% end %>

<table class="seismic-table" id="seismic-jobs" data-status-url="<%= status_project_seismic_jobs_path(@project) %>">
  <thead><tr><th>#</th><th>Document</th><th>Status</th><th>Progress</th><th>By</th><th>Created</th><th></th></tr></thead>
  <tbody>
  <% @jobs.each do |job| %>
    <tr data-job-id="<%= job.id %>">
      <td><%= link_to job.id, project_seismic_job_path(@project, job) %></td>
      <td><%= job.document&.title || '–' %></td>
      <td class="job-status"><span class="seismic-badge seismic-<%= job.status %>"><%= job.status %></span></td>
      <td>
        <div class="seismic-bar"><div class="job-bar" style="width:<%= job.progress_percent %>%"></div></div>
        <small class="job-count"><%= job.done_images + job.failed_images %>/<%= job.total_images %></small>
      </td>
      <td><%= job.user&.name %></td>
      <td><%= format_time(job.created_at) %></td>
      <td class="seismic-row-actions">
        <%= link_to project_seismic_job_path(@project, job), class: 'seismic-icon-btn', title: 'Open analysis', 'aria-label': 'Open analysis' do %><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z"/></svg><% end %>
        <% if User.current.allowed_in_project?(:run_seismic_analysis, @project) %>
          <%= render 'seismic_jobs/delete', job: job %>
        <% end %>
      </td>
    </tr>
  <% end %>
  <% if @jobs.empty? %><tr><td colspan="7">No analyses yet.</td></tr><% end %>
  </tbody>
</table>

<h3>Summary of the latest results</h3>
<% if @summary.empty? %>
  <p>No finished analysis yet.</p>
<% else %>
  <p><%= @summary.images_analysed %> images analysed, <%= @summary.images_with_damage %> with damage detected.</p>
  <ul>
    <% @summary.counts.sort_by { |_, v| -v }.each do |cls, n| %>
      <li><%= SeismicTool::DamageSummary.label(cls) %>: <%= n %></li>
    <% end %>
  </ul>
<% end %>
