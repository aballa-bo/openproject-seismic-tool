<% html_title 'Crack modelling' %>
<%= render 'seismic_models/nav' %>
<h2>Crack modelling</h2>
<p>Pick a single image and get a 3D relief of it (coloured point cloud and mesh). Cracks found in the image are
   highlighted in red and can be engraved into the surface. Scale is relative, not metric.</p>

<% hint = SeismicJob.worker_hint %>
<% if hint && @models.any?(&:active?) %><div class="seismic-warn"><%= hint %></div><% end %>

<% if User.current.allowed_in_project?(:run_seismic_analysis, @project) %>
  <p><%= link_to 'New 3D model from an image', new_project_seismic_model_path(@project), class: 'button -primary' %></p>
<% end %>

<table class="seismic-table">
  <thead><tr><th>#</th><th>Image</th><th>Status</th><th>Result</th><th>By</th><th>Created</th><th></th></tr></thead>
  <tbody>
  <% @models.each do |m| %>
    <tr>
      <td><%= link_to m.id, project_seismic_model_path(@project, m) %></td>
      <td><%= m.filename %></td>
      <td><span class="seismic-badge seismic-<%= m.status %>"><%= m.status %></span></td>
      <td>
        <% if m.done? %><%= number_with_delimiter(m.stats['points']) %> points, <%= number_with_delimiter(m.stats['faces']) %> faces
        <% elsif m.status == 'failed' %><small><%= truncate(m.error.to_s, length: 80) %></small><% end %>
      </td>
      <td><%= m.user&.name %></td>
      <td><%= format_time(m.created_at) %></td>
      <td class="seismic-row-actions">
        <%= link_to project_seismic_model_path(@project, m), class: 'seismic-icon-btn', title: 'Open 3D model', 'aria-label': 'Open 3D model' do %><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z"/></svg><% end %>
        <% if User.current.allowed_in_project?(:run_seismic_analysis, @project) %>
          <%= link_to confirm_delete_project_seismic_model_path(@project, m), class: 'seismic-icon-btn seismic-danger', title: 'Delete 3D model', 'aria-label': 'Delete 3D model' do %><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"/></svg><% end %>
        <% end %>
      </td>
    </tr>
  <% end %>
  <% if @models.empty? %><tr><td colspan="7">No 3D models yet.</td></tr><% end %>
  </tbody>
</table>
